{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/samtay32/ultimate-agent-stack/schemas/work-item.schema.json",
  "title": "Ultimate Agent Stack work ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "updated_at",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "updated_at": {
      "$ref": "#/$defs/timestamp"
    },
    "items": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/workItem"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "maxLength": 96,
      "pattern": "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$"
    },
    "timestamp": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        }
      ]
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "reference"
      ],
      "properties": {
        "provider": {
          "$ref": "#/$defs/identifier"
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paths",
        "out_of_scope"
      ],
      "properties": {
        "paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^(?![A-Za-z]:[\\\\/])(?![\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+$"
          }
        },
        "out_of_scope": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^(?![A-Za-z]:[\\\\/])(?![\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+$"
          }
        }
      }
    },
    "workItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "objective",
        "status",
        "priority",
        "acceptance_criteria",
        "scope",
        "depends_on",
        "evidence_refs",
        "external_refs",
        "updated_at"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "objective": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "status": {
          "enum": [
            "backlog",
            "ready",
            "in_progress",
            "blocked",
            "in_review",
            "done",
            "cancelled"
          ]
        },
        "priority": {
          "enum": [
            "urgent",
            "high",
            "normal",
            "low"
          ]
        },
        "acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "depends_on": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "evidence_refs": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "external_refs": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "updated_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    }
  }
}
