{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/samtay32/ultimate-agent-stack/schemas/review-receipt.schema.json",
  "title": "Ultimate Agent Stack unsigned independent-review candidate",
  "description": "Project-authored candidate evidence. This document is not authenticated worker proof and cannot authorize review completion without trusted outer attestation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "assignment_id",
    "work_item_id",
    "evidence_node_id",
    "mechanism",
    "harness",
    "reviewer_id",
    "base_revision",
    "reviewed_revision",
    "delivery_baseline",
    "standards_verdict",
    "intent_verdict",
    "reviewer_result_sha256",
    "provenance_sha256",
    "read_only",
    "external_actions",
    "started_at",
    "completed_at",
    "result"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "assignment_id": {
      "$ref": "#/$defs/identifier"
    },
    "work_item_id": {
      "$ref": "#/$defs/identifier"
    },
    "evidence_node_id": {
      "$ref": "#/$defs/identifier"
    },
    "mechanism": {
      "enum": [
        "native-subagent",
        "isolated-session",
        "external-provider",
        "human"
      ]
    },
    "harness": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "reviewer_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "base_revision": {
      "$ref": "#/$defs/git_commit"
    },
    "reviewed_revision": {
      "$ref": "#/$defs/git_commit"
    },
    "delivery_baseline": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^\\.agent-stack/artifacts/DELIVERY\\.md@[a-f0-9]{40}$"
    },
    "standards_verdict": {
      "$ref": "#/$defs/verdict"
    },
    "intent_verdict": {
      "$ref": "#/$defs/verdict"
    },
    "reviewer_result_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "provenance_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "read_only": {
      "const": true
    },
    "external_actions": {
      "const": false
    },
    "started_at": {
      "$ref": "#/$defs/timestamp"
    },
    "completed_at": {
      "$ref": "#/$defs/timestamp"
    },
    "result": {
      "enum": [
        "succeeded",
        "failed"
      ]
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "maxLength": 96,
      "pattern": "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$"
    },
    "git_commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "verdict": {
      "enum": [
        "passed",
        "failed"
      ]
    }
  }
}
