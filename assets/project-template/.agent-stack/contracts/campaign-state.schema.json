{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/samtay32/ultimate-agent-stack/schemas/campaign-state.schema.json",
  "title": "Ultimate Agent Stack bounded campaign state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign_id",
    "objective",
    "max_iterations",
    "iterations_completed",
    "active_work_item",
    "status",
    "reason",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "campaign_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "max_iterations": {
      "type": "integer",
      "minimum": 1,
      "maximum": 25
    },
    "iterations_completed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 25
    },
    "active_work_item": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/identifier"
        }
      ]
    },
    "status": {
      "enum": [
        "active",
        "complete",
        "decision-needed",
        "stopped"
      ]
    },
    "reason": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      ]
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "updated_at": {
      "$ref": "#/$defs/timestamp"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "active"
          }
        }
      },
      "then": {
        "properties": {
          "reason": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "maxLength": 96,
      "pattern": "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  }
}
