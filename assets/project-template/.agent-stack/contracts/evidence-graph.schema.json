{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/samtay32/ultimate-agent-stack/schemas/evidence-graph.schema.json",
  "title": "Ultimate Agent Stack evidence graph",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "updated_at",
    "nodes",
    "edges"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "updated_at": {
      "$ref": "#/$defs/timestamp"
    },
    "nodes": {
      "type": "array",
      "maxItems": 20000,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "maxItems": 50000,
      "items": {
        "$ref": "#/$defs/edge"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "maxLength": 96,
      "pattern": "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$"
    },
    "timestamp": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        }
      ]
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "label",
        "state",
        "source",
        "summary"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "enum": [
            "intent",
            "requirement",
            "decision",
            "work_item",
            "file",
            "test",
            "commit",
            "pull_request",
            "review",
            "release",
            "telemetry",
            "checkpoint"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "state": {
          "enum": [
            "planned",
            "active",
            "verified",
            "failed",
            "superseded"
          ]
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider",
            "reference"
          ],
          "properties": {
            "provider": {
              "$ref": "#/$defs/identifier"
            },
            "reference": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          }
        },
        "summary": {
          "type": "string",
          "maxLength": 1000
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "relation"
      ],
      "properties": {
        "from": {
          "$ref": "#/$defs/identifier"
        },
        "to": {
          "$ref": "#/$defs/identifier"
        },
        "relation": {
          "enum": [
            "requires",
            "implements",
            "verifies",
            "reviews",
            "releases",
            "observes",
            "blocks",
            "depends_on",
            "supersedes"
          ]
        }
      }
    }
  }
}
