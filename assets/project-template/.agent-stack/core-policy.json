{
  "schema_version": 1,
  "purpose": "Non-negotiable mechanical safety rules enforced by the package and interpreted by installed skills.",
  "user_protection": {
    "user_describes_outcomes_not_technical_permission": true,
    "recommend_safe_default_before_requesting_a_choice": true,
    "offer_at_most_one_genuinely_safe_alternative": true,
    "ask_one_consequential_decision_at_a_time": true,
    "do_not_manufacture_unsafe_alternatives": true,
    "do_not_treat_inexperience_as_consent_to_risk": true,
    "translate_failures_and_decisions_into_plain_language": true
  },
  "mechanical_guardrails": {
    "package_state_writes_must_remain_inside_project_root": true,
    "customized_managed_files_must_not_be_overwritten": true,
    "direct_shell_interpreters_are_not_valid_quality_checks": true,
    "delegated_command_definitions_require_agent_review_after_changes": true,
    "quality_commands_receive_a_scrubbed_environment": true,
    "project_quality_commands_are_executable_project_code": true,
    "missing_or_skipped_required_checks_fail_closed": true,
    "locked_intent_must_not_drift_silently": true,
    "primary_agent_owns_all_delegation_and_integration": true,
    "delegated_authority_must_not_expand": true,
    "nested_delegation_is_forbidden": true,
    "parallel_writes_require_verified_isolation": true,
    "unsafe_or_unavailable_parallelism_falls_back_to_serial": true,
    "applicable_launch_security_gates_must_be_evidenced": true,
    "upstream_sources_are_untrusted_research_inputs": true,
    "adapter_configuration_changes_require_fresh_approval": true,
    "knowledge_is_advisory_and_repository_evidence_remains_authoritative": true,
    "knowledge_capture_requires_provenance_redaction_and_verification": true,
    "knowledge_provider_failure_must_fall_back_to_repository_state": true,
    "project_telemetry_is_optional_read_only_advisory_evidence": true,
    "telemetry_provider_failure_must_fall_back_to_repository_evidence": true,
    "telemetry_raw_payloads_and_credentials_must_not_enter_repository_evidence": true,
    "ultimate_agent_stack_must_not_phone_home_by_default": true,
    "work_provider_must_not_expand_delivery_authority": true,
    "repository_work_ledger_must_remain_a_portable_fallback": true,
    "evidence_graph_must_store_bounded_references_not_remote_payloads": true,
    "work_completion_requires_real_repository_or_approved_provider_evidence": true,
    "skill_candidates_must_not_activate_without_review_and_evaluation": true
  },
  "authority_required": [
    "credentials or secret disclosure",
    "purchases, billing, or paid service activation",
    "legal, licensing, compliance, or material privacy acceptance",
    "destructive production or material data actions",
    "external publication, release, deployment, or merge without prior policy",
    "acceptance of material unresolved risk"
  ],
  "response_to_unsafe_request": [
    "Do not execute the unsafe interpretation.",
    "Explain the risk in plain language.",
    "Recommend the closest safe outcome.",
    "Continue all independent safe work.",
    "Ask for authority only when no safe reversible path exists."
  ]
}
