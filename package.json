{
  "name": "ultimate-agent-stack",
  "version": "0.7.1",
  "description": "Your Project Steward: guided, provider-neutral delivery with verified continuity, review, and safety gates.",
  "type": "module",
  "bin": {
    "ultimate-agent-stack": "bin/ultimate-agent-stack.mjs"
  },
  "files": [
    ".codex-plugin/",
    "CHANGELOG.md",
    "SECURITY.md",
    "assets/",
    "bin/",
    "docs/",
    "evals/",
    "scripts/github-release-sync.mjs",
    "scripts/gbrain-project.mjs",
    "scripts/packed-smoke.mjs",
    "scripts/release-preflight.mjs",
    "scripts/review-receipt.mjs",
    "scripts/skill-eval.mjs",
    "scripts/upstream-issue.mjs",
    "skills/",
    "sources/",
    "STARTER_PROMPT.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "lint": "node --check bin/ultimate-agent-stack.mjs && node --check scripts/upstream-issue.mjs && node --check scripts/release-preflight.mjs && node --check scripts/packed-smoke.mjs && node --check scripts/review-receipt.mjs && node --check scripts/github-release-sync.mjs && node --check scripts/gbrain-project.mjs && node --check scripts/skill-eval.mjs",
    "eval:contracts": "node scripts/skill-eval.mjs contracts",
    "eval:scaffold": "node scripts/skill-eval.mjs scaffold",
    "eval:behavior": "node scripts/skill-eval.mjs evaluate",
    "upstream:check": "node bin/ultimate-agent-stack.mjs upstream-check",
    "package:check": "npm pack --dry-run --json",
    "package:smoke": "node scripts/packed-smoke.mjs",
    "release:check": "npm run lint && npm test && npm run eval:contracts && npm run package:check && npm run package:smoke",
    "prepublishOnly": "node scripts/release-preflight.mjs"
  },
  "engines": {
    "node": ">=20.12"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samtay32/ultimate-agent-stack.git"
  },
  "bugs": {
    "url": "https://github.com/samtay32/ultimate-agent-stack/issues"
  },
  "homepage": "https://github.com/samtay32/ultimate-agent-stack#readme",
  "keywords": [
    "agents",
    "agent-skills",
    "codex",
    "claude-code",
    "cursor",
    "grok",
    "subagents",
    "multi-agent",
    "software-delivery"
  ],
  "publishConfig": {
    "access": "public"
  }
}
