{
  "name": "ultimate-agent-stack",
  "version": "0.10.1",
  "description": "Your Project Steward: guided, provider-neutral delivery with verified continuity, review, and safety gates.",
  "type": "module",
  "bin": {
    "ultimate-agent-stack": "bin/ultimate-agent-stack.mjs"
  },
  "files": [
    ".gitattributes",
    ".codex-plugin/",
    "CHANGELOG.md",
    "SECURITY.md",
    "assets/",
    "bin/",
    "docs/",
    "evals/",
    "lib/",
    "scripts/github-release-sync.mjs",
    "scripts/gbrain-project.mjs",
    "scripts/linear-readonly.mjs",
    "scripts/linear-write.mjs",
    "scripts/telemetry-readonly.mjs",
    "scripts/check-portable-bundle.mjs",
    "scripts/packed-smoke.mjs",
    "scripts/release-preflight.mjs",
    "scripts/review-receipt.mjs",
    "scripts/skill-eval.mjs",
    "scripts/skill-fixture.mjs",
    "scripts/upstream-issue.mjs",
    "skills/",
    "sources/",
    "STARTER_PROMPT.md"
  ],
  "scripts": {
    "test": "node --test",
    "test:coverage": "node --experimental-test-coverage --test-coverage-include=\"bin/**/*.mjs\" --test-coverage-include=\"lib/**/*.mjs\" --test-coverage-include=\"scripts/**/*.mjs\" --test-coverage-lines=75 --test-coverage-branches=70 --test-coverage-functions=85 --test",
    "lint": "node --check bin/ultimate-agent-stack.mjs && node --check lib/portable-process-source.mjs && node --check lib/portable-process.mjs && node --check scripts/check-portable-bundle.mjs && node --check scripts/upstream-issue.mjs && node --check scripts/release-preflight.mjs && node --check scripts/packed-smoke.mjs && node --check scripts/review-receipt.mjs && node --check scripts/github-release-sync.mjs && node --check scripts/gbrain-project.mjs && node --check scripts/linear-readonly.mjs && node --check scripts/linear-write.mjs && node --check scripts/telemetry-readonly.mjs && node --check scripts/skill-eval.mjs && node --check scripts/skill-fixture.mjs && npm run lint:markdown",
    "lint:markdown": "markdownlint-cli2 \"**/*.md\"",
    "build:portable": "node scripts/check-portable-bundle.mjs --write",
    "check:portable": "node scripts/check-portable-bundle.mjs",
    "eval:contracts": "node scripts/skill-eval.mjs contracts",
    "eval:fixture": "node scripts/skill-fixture.mjs",
    "eval:scaffold": "node scripts/skill-eval.mjs scaffold",
    "eval:behavior": "node scripts/skill-eval.mjs evaluate",
    "eval:routing": "node scripts/skill-eval.mjs routing-rate",
    "upstream:check": "node bin/ultimate-agent-stack.mjs upstream-check",
    "package:check": "npm pack --dry-run --json",
    "package:smoke": "node scripts/packed-smoke.mjs",
    "release:check": "npm run lint && npm run check:portable && npm run test:coverage && npm run eval:contracts && npm run package:check && npm run package:smoke",
    "prepublishOnly": "node scripts/release-preflight.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "cross-spawn": "7.0.6",
    "esbuild": "0.28.1",
    "markdownlint-cli2": "0.23.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samtay32/ultimate-agent-stack.git"
  },
  "bugs": {
    "url": "https://github.com/samtay32/ultimate-agent-stack/issues"
  },
  "homepage": "https://github.com/samtay32/ultimate-agent-stack#readme",
  "keywords": [
    "agents",
    "agent-skills",
    "codex",
    "claude-code",
    "cursor",
    "grok",
    "subagents",
    "multi-agent",
    "software-delivery"
  ],
  "publishConfig": {
    "access": "public"
  }
}
